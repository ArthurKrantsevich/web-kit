{
  "name": "@web-kit/hash-generator",
  "version": "0.0.0",
  "description": "MD5, SHA-1, SHA-2, SHA-3, BLAKE2, BLAKE3, RIPEMD-160 and CRC32 of a text or a file, with a checksum check and HMAC.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurKrantsevich/web-kit.git",
    "directory": "packages/hash-generator"
  },
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
    "./extra": { "types": "./dist/extra.d.ts", "default": "./dist/extra.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsdown && cp src/ui/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "node ../../tooling/scripts/check-use-client.mjs && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css && size-limit"
  },
  "size-limit": [
    { "name": "core", "path": "dist/core.js", "limit": "3 kB" },
    { "name": "extra", "path": "dist/extra.js", "limit": "7 kB" }
  ],
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": { "@types/node": "^26.6.2" }
}
