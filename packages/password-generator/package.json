{
  "name": "@web-kit/password-generator",
  "version": "0.0.0",
  "description": "Passwords, passphrases, PINs and pronounceable passwords from a secure random source, with their exact entropy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurKrantsevich/web-kit.git",
    "directory": "packages/password-generator"
  },
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
    "./wordlist": { "types": "./dist/wordlist.d.ts", "default": "./dist/wordlist.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsdown && node ../../tooling/scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "node ../../tooling/scripts/check-use-client.mjs && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css && size-limit"
  },
  "size-limit": [
    { "name": "core", "path": "dist/core.js", "limit": "2.75 kB" },
    { "name": "wordlist", "path": "dist/wordlist.js", "limit": "22 kB" }
  ],
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "dependencies": {
    "@web-kit/ui": "workspace:*"
  },
  "devDependencies": { "@types/node": "^26.6.2" }
}
