{
  "name": "@web-kit/json-core",
  "version": "0.0.0",
  "description": "Lossless JSON parser and AST, exact error positions, verified fixes, code frames, paths, exact number comparison and a worker for large inputs. No dependencies, no UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurKrantsevich/web-kit.git",
    "directory": "packages/json-core"
  },
  "keywords": [
    "json",
    "parser",
    "ast",
    "validate",
    "formatter"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/worker.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./worker-client": {
      "types": "./dist/worker-client.d.ts",
      "default": "./dist/worker-client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "node ../../tooling/scripts/check-core-only.mjs && publint --strict && attw --pack . --profile esm-only && size-limit"
  },
  "size-limit": [
    {
      "name": "json-core",
      "path": "dist/index.js",
      "limit": "8 kB"
    },
    {
      "name": "worker",
      "path": "dist/worker.js",
      "limit": "4 kB"
    },
    {
      "name": "worker-client",
      "path": "dist/worker-client.js",
      "limit": "1 kB"
    }
  ]
}
