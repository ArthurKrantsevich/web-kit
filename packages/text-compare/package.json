{
  "name": "@web-kit/text-compare",
  "version": "0.0.0",
  "description": "Compare two texts or files side by side, by line, word or character, and export a patch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurKrantsevich/web-kit.git",
    "directory": "packages/text-compare"
  },
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
    "./worker": { "types": "./dist/worker.d.ts", "default": "./dist/worker.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": ["**/*.css", "./dist/worker.js"],
  "scripts": {
    "build": "tsdown && node ../../tooling/scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "node ../../tooling/scripts/check-use-client.mjs && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css && size-limit"
  },
  "size-limit": [
    { "name": "core", "path": "dist/core.js", "limit": "5 kB" },
    { "name": "worker", "path": "dist/worker.js", "limit": "4 kB" }
  ],
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "dependencies": {
    "@web-kit/ui": "workspace:*"
  }
}
