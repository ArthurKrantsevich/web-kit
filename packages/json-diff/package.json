{
  "name": "@web-kit/json-diff",
  "version": "0.0.0",
  "description": "Compare two JSON documents: every change with its path, exact numbers, arrays by index or by key, and a JSON Patch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurKrantsevich/web-kit.git",
    "directory": "packages/json-diff"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown && node ../../tooling/scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "node ../../tooling/scripts/check-use-client.mjs && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css && size-limit"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/core.js",
      "limit": "6 kB"
    }
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@web-kit/json-core": "workspace:*",
    "@web-kit/ui": "workspace:*"
  }
}
