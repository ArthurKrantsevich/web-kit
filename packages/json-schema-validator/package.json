{
  "name": "@web-kit/json-schema-validator",
  "version": "0.0.0",
  "description": "Check JSON against a JSON Schema: every error with its path and place in the data, exact numbers, and a schema generated from the data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurKrantsevich/web-kit.git",
    "directory": "packages/json-schema-validator"
  },
  "keywords": ["json", "json-schema", "validator", "draft-2020-12"],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown && cp src/ui/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "node ../../tooling/scripts/check-use-client.mjs && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css && size-limit"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/core.js",
      "limit": "9 kB"
    }
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@web-kit/json-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
